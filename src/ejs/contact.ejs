<!DOCTYPE html>
<html lang="ja">
  <%- include('./common/_head') %>
  <body>
    <%- include('./common/_top-header') %>
    <main>
      <a name="top"></a>
      <div class="p-contact-main">
      <div class="c-fv">
        <img class="c-fv__img c-fv__img--contact" src="./images/common/contact/contact_fv.jpg" alt="topic">
        <div class="c-fv__fv-text">
         <h2 class="c-font__h2 c-fv__fv-text--h2">お問い合わせ</h2>
        </div>   
      </div>
      <!--固定ヘッダーの背景色変更地点-->
      <div class="target"></div>
      
      <!--パンくず-->
          <nav>
            <ol class="c-breadcrumbs">
              <li class="c-breadcrumbs__blue"><a href="/">HOME</a></li>
              <li>お問い合わせ
              </li>
            </ol>
          </nav>
     

      <section class="p-contact__form">        
          <div class="l-inner">
              <p class="p-contact__top-txt">お問い合わせは下記フォームにて承ります。<br>下記フォームより必要事項をご記入の上、「送信する」ボタンを押してください。</p>

            <div class="p-contact__form__box">
            <form action="contact-thanks.html" method="get" id="contactForm">  <div class="p-contact__form__item">
    <label for="naiyou" class="p-contact__form-ttl p-contact__form-req">お問い合わせ項目</label>
    <div class="p-contact-naiyou">
      <div class="p-contact__select-wrapper">
       <select id="naiyou" name="お問い合わせ項目" class="p-contact__select" required>
        <option value="" selected>選択してください</option>
        <option value="製品について">製品について</option>
        <option value="見積もりについて">見積もりについて</option>
        <option value="採用について">採用について</option>
        <option value="その他のお問い合わせ">その他のお問い合わせ</option>
        <option value="個人情報保護方針について">個人情報保護方針について</option>
        <option value="ウェブサイトについて">ウェブサイトについて</option>
      </select>
      </div>
    </div>
  </div>
  <div class="p-contact__form__item">
    <label for="company" class="p-contact__form-ttl">会社名</label>
    <input type="text" id="company" name="company" placeholder="ゼンショウトレーディング" class="p-contact__form__text">
  </div>
  <div class="p-contact__form__item">
    <label for="name" class="p-contact__form-ttl p-contact__form-req">お名前</label>
    <input type="text" id="name" name="name" placeholder="田中 太郎" class="p-contact__form__text" required> </div>
  <div class="p-contact__form__item">
    <label for="phone" class="p-contact__form-ttl p-contact__form-req">電話番号</label>
    <input type="text" id="phone" name="phone" placeholder="090-000-0000" class="p-contact__form__text" required> </div>
  <div class="p-contact__form__item">
    <label for="email" class="p-contact__form-ttl p-contact__form-req">メールアドレス</label>
    <input type="text" id="email" name="email" placeholder="mail@example.com" class="p-contact__form__text" required> </div>
  <div class="p-contact__form__item">
    <label for="detail" class="p-contact__form-ttl p-contact__form-req">お問い合わせ内容</label>
    <textarea id="detail" name="detail" rows="5" class="p-contact__form__detail"
      placeholder="例: 見積もりをお願いしたいがどのくらいでできるか。この文章はダミーです。文字の大きさ、量、字間、行間等を確認するために入れています。の文章はダミーです。文字の大きさ、量、字間、行間等を確認するために入れています。" required></textarea> </div>

  <div class="p-top__contact--btn">
    <button type="submit" class="c-btn__style-04" id="submitBtn" disabled> 
      <span class="c-btn__style-04-txt">送信する</span>
    </button>
  </div>
</form>
            </div>
          </div>
      </section>
        
      
    </div>
    </main>
    <%- include('./common/_footer') %>
    
    
  </body>
</html>
